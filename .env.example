# ================================================================
# RigRate Electronics Price Comparison Configuration
# ================================================================

# Flask App Secrets
SECRET_KEY=smart-electronics-compare-secret-key-2026
FLASK_DEBUG=1

# ================================================================
# External Product & Price Comparison API Configuration
# ================================================================
# Supported providers: 'serpapi', 'rapidapi', or 'hybrid' (multi-source auto fallback)
PRICE_API_PROVIDER=hybrid

# SerpApi Google Shopping API (Free 100 searches/month at https://serpapi.com)
SERPAPI_API_KEY=your_serpapi_api_key_here

# RapidAPI Real-Time Product Search (Sign up free at https://rapidapi.com)
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_HOST=real-time-product-search.p.rapidapi.com

# Country code ('in' for India, 'us' for United States, etc.) & Currency
PRICE_API_COUNTRY=in
PRICE_API_CURRENCY=INR

# RigRate AI Assistant Configuration (Powered by Yash)
# Get a 100% free Gemini API Key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
